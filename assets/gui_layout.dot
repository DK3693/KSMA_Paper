digraph GUI {
 graph [bgcolor="transparent", rankdir=TB, nodesep=0.20, ranksep=0.28, pad=0.2, fontname="Arial", label="Technical Document Review Console · Layout Schematic", labelloc=t, fontsize=19, fontcolor="#1c375d"];
 node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12, fontcolor="#1d3955", color="#9db7d5", fillcolor="#F0F5FA", penwidth=1.3, margin="0.18,0.13"];
 header [label="Reference PDF  |  Test PDF  |  Run Analysis  |  Progress  |  Summary / Logs", fillcolor="#DCE8F7"];
 left [label="Page Navigator\nRun selection\nNumeric / Visual filters\nPage-level status", width=2.6];
 bef [label="BEFORE Viewer\nPage preview\nZoom / pan\nBounding-box overlays", width=3.0, fillcolor="#EAF2FC"];
 aft [label="ALIGNED AFTER Viewer\nSynchronized navigation\nZoom / pan\nBounding-box overlays", width=3.0, fillcolor="#EAF2FC"];
 right [label="Change Review Panel\nEvent list & verdicts\nSelected-event details\nBefore/after crop view", width=3.1];
 footer [label="Local Desktop UI  |  Tkinter / ttk  |  Analysis outputs and review annotations", fillcolor="#E5F3EA", color="#92BFA1"];
 {rank=same; left; bef; aft; right;}
 header -> left [style=invis];
 left -> bef [style=invis]; bef -> aft [style=invis]; aft -> right [style=invis];
 right -> footer [style=invis];
}
